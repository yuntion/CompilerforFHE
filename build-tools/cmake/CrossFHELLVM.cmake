if(CROSSFHE_LLVM_SOURCE)
  set(LLVM_ENABLE_PROJECTS "mlir" CACHE STRING "" FORCE)
  set(LLVM_TARGETS_TO_BUILD "" CACHE STRING "" FORCE)
  set(LLVM_INCLUDE_TESTS OFF CACHE BOOL "" FORCE)
  set(LLVM_INCLUDE_BENCHMARKS OFF CACHE BOOL "" FORCE)
  set(LLVM_INCLUDE_EXAMPLES OFF CACHE BOOL "" FORCE)
  set(LLVM_ENABLE_ZLIB OFF CACHE BOOL "" FORCE)
  set(LLVM_ENABLE_ZSTD OFF CACHE BOOL "" FORCE)
  set(LLVM_ENABLE_LIBXML2 OFF CACHE BOOL "" FORCE)
  set(LLVM_ENABLE_TERMINFO OFF CACHE BOOL "" FORCE)
  set(LLVM_ENABLE_ASSERTIONS ON CACHE BOOL "" FORCE)
  set(MLIR_ENABLE_BINDINGS_PYTHON OFF CACHE BOOL "" FORCE)
  add_subdirectory("${CROSSFHE_LLVM_SOURCE}/llvm" llvm EXCLUDE_FROM_ALL)
  set(MLIR_CMAKE_DIR "${CROSSFHE_LLVM_SOURCE}/mlir/cmake/modules")
  set(LLVM_CMAKE_DIR "${CROSSFHE_LLVM_SOURCE}/llvm/cmake/modules")
  set(CROSSFHE_MLIR_INCLUDE "${CROSSFHE_LLVM_SOURCE}/mlir/include"
      "${CMAKE_CURRENT_BINARY_DIR}/llvm/tools/mlir/include")
  set(CROSSFHE_LLVM_INCLUDE "${CROSSFHE_LLVM_SOURCE}/llvm/include"
      "${CMAKE_CURRENT_BINARY_DIR}/llvm/include")
else()
  find_package(MLIR REQUIRED CONFIG)
  set(CROSSFHE_MLIR_INCLUDE ${MLIR_INCLUDE_DIRS})
  set(CROSSFHE_LLVM_INCLUDE ${LLVM_INCLUDE_DIRS})
endif()
list(APPEND CMAKE_MODULE_PATH "${MLIR_CMAKE_DIR}" "${LLVM_CMAKE_DIR}")
include(TableGen)
include(AddLLVM)
include(AddMLIR)
include_directories(${CROSSFHE_MLIR_INCLUDE} ${CROSSFHE_LLVM_INCLUDE})
add_definitions(${LLVM_DEFINITIONS})
